DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,findayintelligence.com,www.findayintelligence.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://findayintelligence.com,https://www.findayintelligence.com

# development or production — picks DEV_DB_*/DEV_DJANGO_SECRET_KEY vs
# PROD_DB_*/PROD_DJANGO_SECRET_KEY below, and the DEBUG/HSTS defaults.
ENVIRONMENT=development
# ENVIRONMENT=production
# DJANGO_DEBUG=False

DEV_DJANGO_SECRET_KEY=dev-secret-key-not-for-production-use-only
# Real random key — required in production, no fallback. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
PROD_DJANGO_SECRET_KEY=change-me-in-env

DEV_DB_NAME=bai_dev
DEV_DB_USER=postgres
DEV_DB_PASSWORD=postgres
DEV_DB_HOST=localhost
DEV_DB_PORT=5432

PROD_DB_NAME=bai_prod
PROD_DB_USER=postgres
PROD_DB_PASSWORD=change-me-in-env
PROD_DB_HOST=localhost
PROD_DB_PORT=5432

TIME_ZONE=Asia/Kolkata

# Platform superadmin login — run `python manage.py bootstrap_superadmin`
# after changing either value to push the change into the DB.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-in-env

# Gmail SMTP for password-reset OTP emails. Leave both blank to have emails
# print to the console instead (fine for local dev). EMAIL_HOST_PASSWORD is
# a Gmail "app password", not the account's normal login password — create
# one at myaccount.google.com/apppasswords (requires 2-Step Verification).
#
# For another SMTP provider, also set EMAIL_HOST/EMAIL_PORT. Render's free
# tier blocks ports 25/465/587, so production uses Brevo on 2525:
# EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=2525, EMAIL_HOST_USER=<Brevo
# SMTP login>, EMAIL_HOST_PASSWORD=<Brevo SMTP key>.
#
# --- Brevo (production / Render) ---
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_USE_TLS=True
# Brevo -> SMTP & API -> SMTP tab -> "Login" (NOT your Brevo account email)
EMAIL_HOST_USER=xxxxxx@smtp-brevo.com
# Brevo -> SMTP & API -> SMTP tab -> the generated SMTP key  <-- SMTP KEY GOES HERE
EMAIL_HOST_PASSWORD=paste-your-brevo-smtp-key-here
# A sender verified in Brevo (Senders, Domains & Dedicated IPs)
DEFAULT_FROM_EMAIL=no-reply@findayintelligence.com
#
# --- Gmail alternative (local dev only; blocked on Render free tier) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password

# Shown in the Contact section on the public landing page and where contact
# form submissions are sent. Leave CONTACT_EMAIL blank to reuse EMAIL_HOST_USER.
CONTACT_EMAIL=
CONTACT_PHONE=
