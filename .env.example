DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# development or production — picks DEV_DB_*/DEV_DJANGO_SECRET_KEY vs
# PROD_DB_*/PROD_DJANGO_SECRET_KEY below, and the DEBUG/HSTS defaults.
ENVIRONMENT=development
# ENVIRONMENT=production
# DJANGO_DEBUG=False

DEV_DJANGO_SECRET_KEY=dev-secret-key-not-for-production-use-only
# Real random key — required in production, no fallback. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
PROD_DJANGO_SECRET_KEY=change-me-in-env

DEV_DB_NAME=bai_dev
DEV_DB_USER=postgres
DEV_DB_PASSWORD=postgres
DEV_DB_HOST=localhost
DEV_DB_PORT=5432

PROD_DB_NAME=bai_prod
PROD_DB_USER=postgres
PROD_DB_PASSWORD=change-me-in-env
PROD_DB_HOST=localhost
PROD_DB_PORT=5432

TIME_ZONE=Asia/Kolkata

# Platform superadmin login — run `python manage.py bootstrap_superadmin`
# after changing either value to push the change into the DB.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-in-env
